DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
SESSION_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
CRON_SECRET="another-long-random-string"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
NEXT_PUBLIC_SITE_URL="https://your-site.vercel.app"

# Optional — booking-confirmation texts via ClickSend (clicksend.com). Leave unset to disable.
CLICKSEND_USERNAME="you@example.com"
CLICKSEND_API_KEY="..."
# Optional sending number or registered sender name; leave unset to use ClickSend's shared number.
CLICKSEND_FROM=""

# Optional — booking emails via Resend. Leave unset to disable.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Beeline Accommodation <bookings@beelineaccommodation.com>"
# Optional: where replies to booking emails should go
RESEND_REPLY_TO="bookonbeeline@gmail.com"

# Optional — host subscriptions through Stripe (the platform owner's own Stripe account).
# Use test keys (sk_test_...) until it has been tried end to end. Leave unset to keep billing off.
STRIPE_SECRET_KEY="sk_test_..."
# Four prices: 1 to 3 listings and 4 to 10 listings, each monthly and yearly (amounts in src/lib/pricing.ts)
STRIPE_PRICE_T1_MONTHLY="price_..."
STRIPE_PRICE_T1_YEARLY="price_..."
STRIPE_PRICE_T2_MONTHLY="price_..."
STRIPE_PRICE_T2_YEARLY="price_..."
# Signing secret of the webhook endpoint <site>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."
