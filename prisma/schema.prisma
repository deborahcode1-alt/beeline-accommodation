generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  pendingCodeHash      String? // sha256 of the current email verification code, if one is pending
  pendingCodeExpiresAt DateTime?
  pendingCodeAttempts  Int       @default(0)
  host                 Host?     @relation(fields: [hostId], references: [id])
  hostId               String? // null = platform owner (sees everything); set = a host who only sees their own listings
}

// A guest's own account (separate from host/owner admin logins). Their stays are the bookings
// linked to the account, plus, once the email is verified, any booking made with that email.
model Guest {
  id                   String    @id @default(cuid())
  email                String    @unique // stored lower-case
  name                 String
  passwordHash         String
  emailVerifiedAt      DateTime?
  pendingCodeHash      String? // sha256 of an emailed code (verify email or reset password)
  pendingCodeExpiresAt DateTime?
  pendingCodeAttempts  Int       @default(0)
  failedLogins         Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime? // used for the 7-year retention rule
  createdAt            DateTime  @default(now())

  bookings Booking[]
}

// One per host family/business — holds the Square account payments for their
// listings should be routed to. Credentials are nullable because a host may
// not have Square set up yet; bookings fall back to request-only until then.
model Host {
  id                  String  @id @default(cuid())
  name                String
  notificationEmail   String? // falls back to ADMIN_EMAIL when not set
  notificationPhone   String?
  squareAccessToken   String?
  squareLocationId    String?
  // Public profile shown to guests on each listing.
  bio                 String?
  website             String?
  publicPhone         String?
  publicEmail         String?
  photoUrl            String?
  blurb               String? // short line shown under the host's name
  hostType            String?
  yearsHosting        String?
  livesOnSite         String?
  checkInStyle        String?
  responseTime        String?
  languages           String?
  // Beeline subscription. Listings of a host whose subscription has lapsed are hidden.
  subscriptionStatus  SubscriptionStatus @default(TRIAL)
  trialEndsAt         DateTime?
  subscriptionRenewsAt DateTime?
  stripeCustomerId    String?
  stripeSubscriptionId String?
  createdAt           DateTime @default(now())

  listings   Listing[]
  adminUsers AdminUser[]
  messages   HostMessage[]
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  COMPLIMENTARY // the platform owner's own listings (Marcus), no charge
}

enum BookingMode {
  REQUEST // host reviews every request
  INSTANT // confirmed straight away if the dates are free
}

// A guest's question to a host, sent from a listing page.
model HostMessage {
  id        String   @id @default(cuid())
  host      Host?    @relation(fields: [hostId], references: [id])
  hostId    String?
  listingId String?
  listingName String?
  name      String
  email     String
  phone     String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// A property owner asking to list on Beeline, submitted from /host.
model HostEnquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  area      String
  details   String?
  photoUrls String   @default("[]") // JSON array of uploaded house photo URLs
  createdAt DateTime @default(now())
}

// A place guests search for, e.g. Gympie. Each area gets its own landing page
// at /<slug> titled "<name> Accommodation".
model Area {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  state      String   @default("QLD")
  headline   String?
  intro      String?
  heroImage  String?
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())

  listings Listing[]
}

enum PropertyType {
  BUDGET // budget rooms and stays
  LUXURY // luxury stays
  APARTMENT
  FARM_STAY // acreage / farm stay
  BOUTIQUE_HOTEL // boutique hotel rooms
  HOUSE // whole houses and townhouses
}

enum StayType {
  SHORT_TERM
  LONG_TERM
}

model Listing {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  tagline            String?
  description        String
  cancellationPolicy String? // falls back to a site-wide default draft policy when null
  address            String?
  stayType           StayType @default(SHORT_TERM)
  propertyType       PropertyType @default(HOUSE)
  petFriendly        Boolean  @default(false)
  parking            String   @default("NONE") // NONE, STREET, OFF_STREET, COVERED
  bookingMode        BookingMode @default(REQUEST)
  area               Area?    @relation(fields: [areaId], references: [id])
  areaId             String?
  maxGuests          Int      @default(2)
  bedrooms           Int      @default(1)
  beds               Int      @default(1)
  baths              Float    @default(1)
  basePrice          Float
  cleaningFee        Float    @default(0)
  minNights          Int      @default(1)
  amenities          String   @default("[]") // JSON string array
  icalExportToken    String   @unique @default(cuid())
  published          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  host           Host?           @relation(fields: [hostId], references: [id])
  hostId         String?
  photos         Photo[]
  bookings       Booking[]
  blockedDates   BlockedDate[]
  icalImports    IcalImportUrl[]
}

model Photo {
  id        String  @id @default(cuid())
  url       String
  alt       String  @default("")
  order     Int     @default(0)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

enum PaymentStatus {
  UNPAID // no payment processor connected yet, or payment not yet collected
  PAID
  REFUNDED
}

model Booking {
  id             String        @id @default(cuid())
  listing        Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId      String
  guestName      String
  guestEmail     String
  guestPhone     String?
  checkIn        DateTime
  checkOut       DateTime
  guests         Int           @default(1)
  status         BookingStatus @default(PENDING)
  totalPrice     Float
  message        String?
  agreedToTerms  Boolean       @default(false)
  paymentStatus  PaymentStatus @default(UNPAID)
  squarePaymentId String?
  confirmationTextSentAt DateTime?
  confirmationEmailSentAt DateTime?
  manageToken    String        @unique @default(cuid())
  guestAccount   Guest?        @relation(fields: [guestAccountId], references: [id], onDelete: SetNull)
  guestAccountId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([listingId, checkIn, checkOut])
  @@index([guestAccountId])
}

model BlockedDate {
  id        String   @id @default(cuid())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  date      DateTime
  reason    String?
  source    String   @default("manual") // "manual", or an IcalImportUrl id (one connected calendar)

  @@unique([listingId, date, source])
}

model IcalImportUrl {
  id           String    @id @default(cuid())
  listing      Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId    String
  url          String
  label        String    @default("Calendar")
  lastSyncedAt DateTime?
  lastError    String?
}
